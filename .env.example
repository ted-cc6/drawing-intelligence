# Copy to .env and fill in. Never commit .env.

# --- LLM providers (only these two are used) ---
OPENAI_API_KEY=
QWEN_API_KEY=

# --- Data retention ---
# ephemeral (default): every session's files and results are deleted when the session ends.
# keep: development mode - keep session workspaces and the LLM response cache in data/.
DI_RETENTION=ephemeral

# --- Optional overrides (paths are relative to the repo root) ---
# DI_DATA_DIR=data
# DI_CONFIG_DIR=config
# DI_API_TIMEOUT_S=600
