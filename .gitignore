# Client data in data/ IS committed (ADR 0007). Only secrets, local tooling and session workspaces are ignored.

# --- secrets: never commit ---
.env
.env.*
!.env.example

# --- Python / tools ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.ipynb_checkpoints/

# --- editors / OS ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
~$*

# --- spikes: bulky per-drawing outputs (summaries go in spikes/*/results/) ---
spikes/*/out/

# --- session workspaces: run history, not client data (ADR 0010). Committing them caused merge conflicts, and
# the ephemeral sweep deleted the committed ones. ---
data/sessions/
data/feedback/
