# Client data in data/ IS committed (ADR 0007). Only secrets and local tooling are ignored.

# --- secrets: never commit ---
.env
.env.*
!.env.example

# --- Python / tools ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.ipynb_checkpoints/

# --- editors / OS ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
~$*
